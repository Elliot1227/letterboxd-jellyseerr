[Unit]
Description=Letterboxd Jellyseerr Widget API
After=network.target

[Service]
Type=simple
User=your_user
WorkingDirectory=/home/your_user/letterboxd-jellyseerr
ExecStart=/usr/bin/python3 /home/your_user/letterboxd-jellyseerr/api.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
